# ---- Database: Supabase Postgres, "Transaction pooler" URI (port 6543) ----
# Leave unset for local development: scores go to .data/store.json instead.
DATABASE_URL=

# ---- X-ray images: Supabase Storage (private bucket) ----
# Project Settings -> API Keys -> create a *secret* key. Leave unset locally to read ./Images from disk.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=xrays

# ---- Passcode email over SMTP ----
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<address>  SMTP_PASS=<App Password>
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465  SMTP_USER=resend     SMTP_PASS=<API key>  MAIL_FROM=<verified sender>
# Leave SMTP_USER/SMTP_PASS unset locally: the passcode is shown on the login screen instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="mRUST Scorer <scorer@example.com>"

# ---- App ----
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Bootstrap only: seeds the users table the first time the app runs against an empty database.
# After that, raters and admins are managed from the /admin dashboard.
ALLOWED_EMAILS=admin@example.com,rater@example.com
ADMIN_EMAILS=admin@example.com

# Optional demo login for trying the interface: skips email, uses this fixed passcode, never saves scores.
DEMO_EMAIL=
DEMO_PASSCODE=
